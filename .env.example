# ---- Supabase (required) ----
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cryptographic secrets (required) ----
# 32-byte key, base64 encoded. Encrypts upstream provider credentials at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Long random pepper used to HMAC platform API keys. Generate with: openssl rand -hex 32
PLATFORM_KEY_PEPPER=

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Anvex

# ---- Gateway / SSRF policy ----
# Extra upstream hosts allowed in addition to hosts of registered APIs.
GATEWAY_ALLOWED_HOSTS=api-rebix.zone.id
# Comma separated ports permitted for outbound gateway requests.
GATEWAY_ALLOWED_PORTS=80,443
# Hard cap on downstream response bytes read by the gateway.
GATEWAY_MAX_RESPONSE_BYTES=2097152
# Default upstream timeout (a per-API timeout may lower this).
GATEWAY_REQUEST_TIMEOUT_MS=20000
# Allowlist enforcement mode. Keep true in production: only hosts belonging to
# registered APIs / providers or listed in GATEWAY_ALLOWED_HOSTS can be called
# by the execution gateway. (The authenticated "probe" endpoint for adding a new
# API is separate and always blocks private addresses.)
GATEWAY_ENFORCE_HOST_ALLOWLIST=true
# NEVER enable in production. Only for local integration tests.
GATEWAY_TEST_ALLOW_PRIVATE=false
